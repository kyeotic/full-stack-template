{
  "name": "APP_NAME",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev --var WEBPUSH_KEYS_JSON:$WEBPUSH_KEYS_JSON",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "build": "vite build",
    "serve": "vite preview",
    "deploy": "run-s build deploy:worker",
    "deploy:worker": "wrangler deploy",
    "deploy:infra": "./infra/deploy",
    "push-secrets": "echo $WEBPUSH_KEYS_JSON | npx wrangler secret put WEBPUSH_KEYS_JSON",
    "keygen": "node --input-type=module < src/server/webpush/keygen.ts",
    "check": "run-s style lint",
    "check:ci": "run-s style:ci lint:ci",
    "style": "prettier  --write \"src/**/*.{ts,tsx}\"",
    "style:ci": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src --fix",
    "lint:ci": "eslint src"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "^4.0.17",
    "@trpc/server": "^11.0.0",
    "@types/lodash": "^4.14.191",
    "npm-run-all2": "^7.0.2",
    "postcss": "^8.4.19",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.17",
    "tailwindcss-safe-area": "^0.2.2",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-solid": "^2.11.6",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.1.3",
    "@pushforge/builder": "^1.0.0",
    "@solid-primitives/map": "^0.6.0",
    "@solidjs/router": "^0.15.3",
    "@thednp/solid-color-picker": "^0.0.14",
    "@thisbeyond/solid-select": "^0.15.0",
    "@trpc/client": "^11.0.0",
    "classnames": "^2.3.2",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^2.29.3",
    "hono": "^4.0.0",
    "jose": "^5.0.0",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.0",
    "rfc4648": "^1.5.3",
    "solid-forms": "^0.4.6",
    "solid-js": "^1.9.5",
    "solid-toast": "^0.5.0",
    "store2": "^2.14.2",
    "superjson": "^2.2.2",
    "url-join": "^5.0.0",
    "zod": "^3.25.48"
  },
  "engines": {
    "node": ">=18"
  }
}
